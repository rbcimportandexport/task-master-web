# ==========================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill real values
# NEVER commit real '.env' files to Git!
# ==========================================

# Application Settings
APP_NAME=Warehouse_Task_Master
APP_ENV=development
APP_DEBUG=true

# Firebase & Cloud API Config
FIREBASE_PROJECT_ID=todo-list-app-ef186
FIREBASE_API_KEY=your_firebase_api_key_here
FCM_SERVER_KEY=your_fcm_server_key_here

# Security & API Secrets
API_SECRET_KEY=your_jwt_or_api_secret_key
ENCRYPTION_KEY=your_32_char_encryption_key
